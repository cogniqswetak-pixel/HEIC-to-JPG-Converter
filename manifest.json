{
  "manifest_version": 3,
  "name": "HEIC to JPG Converter",
  "version": "1.0.0",
  "description": "Convert HEIC and HEIF photos from iPhone to JPG or PNG in bulk. 100% private, client-side processing.",
  "background": {
    "service_worker": "js/background.js"
  },
  "action": {
    "default_title": "HEIC to JPG Converter"
  },
  "permissions": [
    "storage",
    "downloads"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
